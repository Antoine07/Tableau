    <worksheet name='Etape 4 Le montant net_sales inclut-il déjà la remise ? Comment le vérifier à partir de quantity, unit_price et discount_rate sur quelques lignes ?'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Le montant </run>
            <run fontcolor='#000000' fontname='Menlo' fontsize='12'>net_sales</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> inclut-il déjà la remise ?</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Oui. La comparaison entre les ventes enregistrées et les ventes recalculées montre une concordance visuelle. Le contrôle numérique des écarts permettra de confirmer cette égalité sur l&apos;ensemble des lignes.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='customers' name='federated.11k04zn180o15n17ln4pa041huot' />
          </datasources>
          <datasource-dependencies datasource='federated.11k04zn180o15n17ln4pa041huot'>
            <column caption='Ventes recalculées' datatype='real' name='[Calculation_3436927225196550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[quantity] * [unit_price] * (1 - [discount_rate])' />
            </column>
            <column caption='Discount Rate' datatype='real' name='[discount_rate]' role='measure' type='quantitative' />
            <column caption='Line Id' datatype='string' name='[line_id]' role='dimension' type='nominal' />
            <column caption='Net Sales' datatype='real' name='[net_sales]' role='measure' type='quantitative' />
            <column-instance column='[line_id]' derivation='None' name='[none:line_id:nk]' pivot='key' type='nominal' />
            <column caption='Quantity' datatype='integer' name='[quantity]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3436927225196550]' derivation='Sum' name='[sum:Calculation_3436927225196550:qk]' pivot='key' type='quantitative' />
            <column-instance column='[net_sales]' derivation='Sum' name='[sum:net_sales:qk]' pivot='key' type='quantitative' />
            <column caption='Unit Price' datatype='integer' name='[unit_price]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
          <pane id='1' selection-relaxation-option='selection-relaxation-allow' x-axis-name='[federated.11k04zn180o15n17ln4pa041huot].[sum:net_sales:qk]'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
          <pane id='2' selection-relaxation-option='selection-relaxation-allow' x-axis-name='[federated.11k04zn180o15n17ln4pa041huot].[sum:Calculation_3436927225196550:qk]'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows>[federated.11k04zn180o15n17ln4pa041huot].[none:line_id:nk]</rows>
        <cols>([federated.11k04zn180o15n17ln4pa041huot].[sum:net_sales:qk] + [federated.11k04zn180o15n17ln4pa041huot].[sum:Calculation_3436927225196550:qk])</cols>
