    </worksheet>
    <worksheet name='Etape 1.2 - Comprendre le grain'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;</run>
            <run fontsize='12'>1/ </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Menlo' fontsize='12'>sales_lines</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> → </run>
            <run fontcolor='#000000' fontname='Menlo' fontsize='12'>products</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> : plusieurs lignes de vente peuvent concerner un même produit.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Menlo' fontsize='12'>sales_lines</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> → </run>
            <run fontcolor='#000000' fontname='Menlo' fontsize='12'>customers</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> : plusieurs lignes de vente peuvent concerner un même client.</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>2/ La relation entre </run>
            <run fontcolor='#000000' fontname='Menlo' fontsize='12'>sales_lines</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> et </run>
            <run fontcolor='#000000' fontname='Menlo' fontsize='12'>return_events</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Une même ligne de vente peut faire l&apos;objet de plusieurs événements de retour.</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources />
          <aggregation value='true' />
        </view>
        <style />
